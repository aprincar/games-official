{
  "manifestVersion": 1,
  "id": "aprincar.guided-painting",
  "kind": "game",
  "version": "1.1.0",
  "publisher": "aprincar",
  "name": {
    "pt-BR": "Pintura por Cores"
  },
  "description": {
    "pt-BR": "Escolha tintas e pinte partes grandes seguindo cor e símbolo."
  },
  "engines": {
    "aprincar": "^1.0.0",
    "sdkProtocol": 1
  },
  "entrypoints": {
