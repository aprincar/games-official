{
  "manifestVersion": 1,
  "id": "aprincar.write-a",
  "kind": "game",
  "version": "1.1.0",
  "publisher": "aprincar",
  "name": {
    "pt-BR": "Ateliê de Letras"
  },
  "description": {
    "pt-BR": "Desenhe letras com apoio visual que diminui conforme você avança."
  },
  "engines": {
    "aprincar": "^1.0.0",
    "sdkProtocol": 1
  },
  "entrypoints": {
    "game": "game.html"
  },
  "permissions": [
    "handwriting"
  ],
  "optionalPermissions": [],
  "contributes": {
    "skills": [
      "writing.trace-letter"
    ],
    "secondarySkills": [],
    "ageGuidance": {
      "min": 4,
      "max": 8
    },
    "interests": [
      "letters",
      "writing"
    ],
    "playType": "practice"
  },
  "experience": {
    "fantasy": "Escola de escrita",
    "mechanic": "trace",
    "interaction": "draw",
    "progression": {
      "maxLevel": 5,
      "adaptive": true
    },
    "learningSignals": [
      "strokeOrder",
      "shape"
    ]
  },
  "offline": true,
  "bundleMode": "single-html"
}